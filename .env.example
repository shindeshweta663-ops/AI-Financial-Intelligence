# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@127.0.0.1:5432/financial_intelligence
TWELVE_DATA_API_KEY=your_twelve_data_key
FINNHUB_API_KEY=your_finnhub_key
FRED_API_KEY=your_fred_key
SEC_USER_AGENT=Your Name your_email@example.com
# Optional: NewsAPI is not currently used (Finnhub is the news source)
NEWS_API_KEY=your_newsapi_key_optional
